# ─── Tri-Hybrid Engine — Environment Variables ────────────────────────────────
# Copy this file to .env and fill in your real keys.
# The engine reads .env automatically on startup.

# ── Required API Keys ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE
OPENAI_API_KEY=sk-YOUR_KEY_HERE

# ── Model Selection ───────────────────────────────────────────────────────────
# LLaMA: any model pulled via `ollama pull <model>`
LLAMA_MODEL=llama3.2
# OpenAI: gpt-4o-mini (cheap) | gpt-4o (better) | gpt-4-turbo
OPENAI_MODEL=gpt-4o-mini
# Claude: claude-haiku-4-5-20251001 (fast) | claude-sonnet-4-6 (balanced) | claude-opus-4-6 (max)
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ── Routing Thresholds ────────────────────────────────────────────────────────
# Adjust to shift budget/quality balance:
# Lower LLAMA_THRESHOLD = more requests to LLaMA (cheaper, lower quality)
# Higher OPENAI_THRESHOLD = more requests to Claude (more expensive, higher quality)
LLAMA_THRESHOLD=0.30
OPENAI_THRESHOLD=0.60

# ── Confidence & Escalation ───────────────────────────────────────────────────
CONFIDENCE_THRESHOLD=0.55
MAX_ESCALATIONS=2

# ── Token Limits ──────────────────────────────────────────────────────────────
MAX_INPUT_TOKENS=3000
MAX_OUTPUT_TOKENS=1024

# ── Concurrency ───────────────────────────────────────────────────────────────
CONCURRENT_REQUESTS=10
