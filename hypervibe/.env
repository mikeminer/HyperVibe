# HyperVibe Configuration
# Copy this to .env and fill in your values

# Anthropic API key (required)
ANTHROPIC_API_KEY=sk-ant-api03-vGF**********

# Hyperliquid wallet private key (required for trading)
# NEVER share this. Stored only locally in ~/.hypervibe/
HL_PRIVATE_KEY=0x6*******

# Hyperliquid wallet address (your public address)
HL_WALLET_ADDRESS=0x2****************

# Network: mainnet or testnet
HL_NETWORK=mainnet

# Optional: vault address if trading via a vault
# HL_VAULT_ADDRESS=0x...

# Server port
PORT=3001
