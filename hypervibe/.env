# HyperVibe Configuration
# Scegli il provider e decommenta le righe corrispondenti

# ── OPZIONE 1: Anthropic API ──────────────────────────────
# PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-4-20250514

# ── OPZIONE 2: Qwen 2.5 14B locale ───────────────────────
PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_BASE_URL=http://localhost:11434

# ── OPZIONE 3: Gemma 4 26B MoE locale ────────────────────
# PROVIDER=ollama
# OLLAMA_MODEL=gemma4:26b
# OLLAMA_BASE_URL=http://localhost:11434

# ── Hyperliquid ───────────────────────────────────────────
HL_WALLET_ADDRESS=0x
HL_PRIVATE_KEY=0x
# HL_VAULT_ADDRESS=0x

# ── Network ───────────────────────────────────────────────
HL_NETWORK=mainnet

# ── App ───────────────────────────────────────────────────
PORT=3001

# ── Telegram (opzionale) ──────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
